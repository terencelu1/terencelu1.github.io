---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { t, localePath, formatDate, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  project: CollectionEntry<'projects'>;
  slug: string;
}

const { lang, project, slug } = Astro.props;
const p = project.data;
const { Content } = await render(project);
const repoName = (url: string) => url.replace(/^https:\/\/github\.com\//, '');

// 上一個／下一個作品（依日期由新到舊）
const all = (await getCollection('projects', (e) => e.id.startsWith(`${lang}/`) && e.data.hasDetail)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const idx = all.findIndex((e) => e.id === project.id);
const newer = all[idx - 1];
const older = all[idx + 1];
const projectsHref = localePath(lang, '/projects/');

// 主圖用封面；沒有封面時退回第一張畫面。其餘畫面放到下方
const hero = p.cover ?? p.gallery[0]?.src;
const heroCaption = p.gallery.find((g) => g.src.src === hero?.src)?.caption;
const rest = p.gallery.filter((g) => g.src.src !== hero?.src);
const hrefOf = (e: CollectionEntry<'projects'>) => localePath(lang, `/projects/${e.id.split('/')[1]}/`);
---

<Base lang={lang} title={p.title} description={p.summary} active="projects">
  <article class="container detail">
    <p class="crumb mono">
      <a href={localePath(lang, '/')}>~</a>/<a href={projectsHref}>projects</a>/<span>{slug}</span>
    </p>

    <header class="head">
      <div class="head-meta mono">
        {p.award && <span class:list={['badge', { 'badge--muted': p.kind !== 'competition' }]}>{p.award}</span>}
        <span>{p.event}</span>
      </div>
      <h1>{p.title}</h1>
      <p class="lede">{p.summary}</p>
    </header>

    <dl class="spec window mono">
      <div><dt>{t(lang, 'project.date')}</dt><dd>{formatDate(p.date)}</dd></div>
      {p.role && <div><dt>{t(lang, 'project.role')}</dt><dd>{p.role}</dd></div>}
      <div><dt>{t(lang, 'project.stack')}</dt><dd><ul class="chips">{p.stack.map((s) => <li>{s}</li>)}</ul></dd></div>
      {
        (p.links.github.length > 0 || p.links.video || p.links.news) && (
          <div>
            <dt>{t(lang, 'project.links')}</dt>
            <dd class="links">
              {p.links.github.map((g) => <a href={g} target="_blank" rel="noopener">github/{repoName(g)} ↗</a>)}
              {p.links.video && <a href={p.links.video} target="_blank" rel="noopener">video ↗</a>}
              {p.links.news && <a href={p.links.news} target="_blank" rel="noopener">news ↗</a>}
            </dd>
          </div>
        )
      }
    </dl>

    {
      hero && (
        <figure class="hero-shot window">
          <div class="window-bar">
            <div class="window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
            <span>{heroCaption ?? p.title}</span>
          </div>
          <Image src={hero} alt={heroCaption ?? p.title} loading="eager" widths={[800, 1400, 2000]} sizes="(max-width: 1120px) 100vw, 1080px" />
        </figure>
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      rest.length > 0 && (
        <section class="gallery">
          <h2 class="mono">{t(lang, 'project.gallery')}</h2>
          <div class="gallery-grid">
            {rest.map((g) => (
              <figure>
                <a href={g.src.src} target="_blank" rel="noopener">
                  <Image src={g.src} alt={g.caption} widths={[600, 1000]} sizes="(max-width: 860px) 100vw, 530px" />
                </a>
                <figcaption>{g.caption}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <nav class="pager mono" aria-label="projects">
      {newer ? <a href={hrefOf(newer)}><span>← {t(lang, 'project.prev')}</span>{newer.data.title}</a> : <span />}
      <a class="up" href={projectsHref}>cd ..</a>
      {older ? <a class="older" href={hrefOf(older)}><span>{t(lang, 'project.next')} →</span>{older.data.title}</a> : <span />}
    </nav>
  </article>
</Base>

<style>
  .detail { padding-top: 2.5rem; }

  .crumb { margin: 0 0 2rem; font-size: 0.85rem; color: var(--text-faint); }
  .crumb a { color: var(--text-muted); }
  .crumb span { color: var(--text); }

  .head { max-width: var(--measure); }
  .head-meta { display: flex; align-items: center; gap: 0.6rem; font-size: 0.85rem; color: var(--text-muted); }
  h1 {
    margin: 0.8rem 0 0.8rem;
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .lede { margin: 0; font-size: 1.15rem; color: var(--text-muted); }

  .spec { margin: 2rem 0; padding: 0.5rem 1.25rem; font-size: 0.85rem; }
  .spec div { display: grid; grid-template-columns: 6rem 1fr; gap: 1rem; padding: 0.7rem 0; }
  .spec div + div { border-top: 1px dashed var(--border); }
  .spec dt { color: var(--text-faint); }
  .spec dt::before { content: '> '; color: var(--accent); }
  .spec dd { margin: 0; color: var(--text); }
  .links { display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; }

  .hero-shot { margin: 0 0 1rem; }
  .hero-shot :global(img) { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; object-position: center top; }

  .gallery { margin-top: 3.5rem; }
  .gallery h2 { font-size: 1.2rem; margin: 0 0 1.25rem; }
  .gallery h2::before { content: '## '; color: var(--accent); }
  .gallery-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  .gallery figure { margin: 0; }
  .gallery a { display: block; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  .gallery a:hover { border-color: var(--accent); }
  figcaption { margin-top: 0.6rem; font-size: 0.9rem; color: var(--text-muted); }

  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
  }
  .pager a { display: flex; flex-direction: column; gap: 0.25rem; color: var(--text); }
  .pager a span { color: var(--text-faint); font-size: 0.75rem; }
  .pager a:hover { color: var(--accent); text-decoration: none; }
  .pager .up { color: var(--accent); align-self: center; }
  .pager .older { text-align: right; }

  @media (max-width: 860px) {
    .gallery-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .pager { grid-template-columns: 1fr 1fr; }
    .pager .up { grid-column: 1 / -1; grid-row: 1; justify-self: center; }
    .spec div { grid-template-columns: 1fr; gap: 0.3rem; }
  }
</style>
